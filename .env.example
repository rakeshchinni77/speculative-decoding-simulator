# Hugging Face token (optional for public models, required for gated checkpoints)
HF_TOKEN=

# Model Identifiers
DRAFT_MODEL_ID=gpt2
TARGET_MODEL_ID=gpt2-large

# Execution Device: 'auto', 'cpu', or 'cuda'
DEVICE=auto

# Decoding Hyperparameters
MAX_NEW_TOKENS=15
DEFAULT_N_DRAFT=4

# Paths Configuration
DATA_DIR=data
RESULTS_DIR=results
LOG_DIR=logs
